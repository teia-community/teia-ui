# Shadownet test mode for the on-chain events + profiles registries.
# Run with:  npm start -- --mode shadownet
#
# Loaded on top of .env. The rest of the app keeps reading mainnet data
# (TzKT, teztok), but the wallet and EVERY write go to shadownet — minting,
# swapping etc. will fail in this mode. Sync a wallet that is set to shadownet.

# Turns the registries on (unset = mocked events + local card drafts).
VITE_REGISTRIES_TZKT_API='https://api.shadownet.tzkt.io'
VITE_REGISTRIES_RPC='https://rpc.shadownet.teztnets.com'

# Shadownet role contracts the two registries are wired to.
VITE_REGISTRIES_MULTISIG='KT1KeGd4YtjcKqgyiXUPJQkm2iYA3fQwLGQP'
VITE_REGISTRIES_MODERATOR='KT1K8QLWkvDFmNFaD5oRvGGYSGRYxq7H7Wv5'
VITE_REGISTRIES_TOKEN='KT1Mi8MejYS9agBUnhuHGHSvLf6ZVuwMgsM3'
